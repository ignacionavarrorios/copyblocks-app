# Flowi AI ingest backend — variables de entorno
# Copiar a .env para desarrollo local (nunca commitear .env real)

PORT=8080

# Supabase — usar la Service Role key acá (NO la anon key), este backend ya verifica
# la identidad del usuario con su access_token antes de tocar datos (ver requireUser()).
SUPABASE_URL=https://igsiomctgvxqowchdrbi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Groq — fallback de transcripción con whisper-large-v3-turbo, se usa solo si Apify
# no está configurado o falla. https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI — solo para embeddings (text-embedding-3-small), no para generar copy.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — Claude Sonnet, usado para responder en el chat con el cerebro (RAG).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Apify — camino PRINCIPAL de scraping/transcripción (más barato y confiable que pelear
# el anti-bot de cada plataforma nosotros mismos). https://console.apify.com/account/integrations
# Sin esto configurado, el pipeline usa yt-dlp+Groq directo.
APIFY_API_TOKEN=
# IDs de actor por plataforma — TODAVÍA SIN ELEGIR, hay varias opciones de precio/autor
# distintas para cada una. Completar una vez decidido cuál usar por plataforma.
APIFY_YOUTUBE_ACTOR_ID=
APIFY_TIKTOK_ACTOR_ID=
APIFY_INSTAGRAM_ACTOR_ID=
APIFY_FACEBOOK_ACTOR_ID=

# Opcional: ruta a un binario yt-dlp ya instalado en el servidor (Linux). Si se deja vacío,
# yt-dlp-wrap-plus intenta usar "yt-dlp" del PATH.
YTDLP_PATH=
